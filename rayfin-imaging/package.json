  "type": "module",
  "template": {
    "name": "gettingstartedauth",
    "displayName": "A Todo App with Auth and Getting Started Docs",
    "description": "Todo app with Fabric authentication, Tailwind CSS, and production-first workflow"
  },
  "scripts": {
    "prebuild": "rayfin env --framework vite",
    "dev": "rayfin dev",
    "dev:frontend": "vite",
    "dev:local": "vite --mode localdata",
    "preview:local": "vite build --mode localdata --outDir dist-local && vite preview --mode localdata --outDir dist-local",
    "dev:fabric": "vite",
    "build": "tsc -b && vite build",
    "build:fabric": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "rayfin:up": "rayfin up",
    "rayfin:db": "rayfin up db apply"
  },
