        "partitions": [
          {
            "name": "MarketingEventFact",
            "mode": "directQuery",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(\"%%sql_endpoint%%\", \"%%default_lakehouse_name%%\"),",
                "    dbo_marketingeventfact = Source{[Schema=\"dbo\",Item=\"MarketingEventFact\"]}[Data]",
                "in",
                "    dbo_marketingeventfact"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "AttributionModelCriteria",
            "expression": [
              "",
              "// Initialize a DAX variable to store the selected option from 'attributionmodeldim' table.  ",
              "// If no value is selected, the default value will be 2.  ",
              "VAR SelectedOption = SELECTEDVALUE('AttributionModelDim'[AttributionModelKey], 2)  ",
              "  ",
              "// Return the result based on the selected option.  ",
              "// If the selected option is 1, then check if 'RankingbyEventDate' equals to 1. If true, return 1, else return blank.  ",
              "// If the selected option is not 1, return 1.  ",
              "RETURN    ",
              "IF(    ",
              "    SelectedOption = 1,  // Check if the selected option is 1  ",
              "    IF([RankingbyEventDate] = 1, 1, BLANK()),  // If selected option is 1, further check 'RankingbyEventDate'  ",
              "    1  // If selected option is not 1, return 1  ",
              ")    "
            ],
            "lineageTag": "84161449-f98d-4c30-b91a-a280b270d39a"
          },
          {
            "name": "RankingbyEventDate",
            "description": "Rank of every unique appointment in the events, using the latest EventDate associated with that Appointment ID",
            "expression": [
              "",
              "VAR CurrentAppointmentKey = MAX('MarketingEventFact'[AppointmentKey])  ",
              "VAR CurrentEventDate = MAX('MarketingEventFact'[EventDate])  ",
              "RETURN  ",
              "COUNTROWS(  ",
              "    FILTER(  ",
              "        CALCULATETABLE(  ",
              "            'MarketingEventFact',  ",
              "            ALLEXCEPT('MarketingEventFact', 'MarketingEventFact'[AppointmentKey])",
              "        ),  ",
              "        'MarketingEventFact'[AppointmentKey] = CurrentAppointmentKey  ",
              "            && 'MarketingEventFact'[EventDate] >= CurrentEventDate  ",
              "    )  ",
              ")  ",
              ""
            ],
            "formatString": "0",
            "lineageTag": "2439178a-f76f-4d61-aa62-f607a2b7e856"
          },
          {
            "name": "PatientsWithNewServiceline",
            "description": "Total count of patients without previous appointments for the same service line prior before the selected time frame.",
            "expression": [
              "",
              "VAR MinEventDate = CALCULATE(MIN(MarketingEventFact[EventDate])) ",
              "VAR SelectedServiceLineKey = SELECTEDVALUE('ServiceLineDim'[ServiceLineKey])  ",
              "VAR SelectedJourneyKey = SELECTEDVALUE('JourneyDim'[JourneyKey])  ",
              "//calculate the number of unique patients (\"PatientsWithNewServiceline\") who haven't had any appointments or encounters in a selected service line before a specified date (\"MinEventDate\"), but have had at least one fulfilled appointment and one finished encounter on or before the same date, regardless of the service line.",
              "VAR NewPatientIds =   ",
              "//The PatientKey is not blank.",
              "//The patient does not have a previous appointment, i.e., there is no record in the appointmentdim table with the same PatientKey, a AppointmentScheduledDate ///before //the EventDate from the marketingeventfact table, and an appointment status of \"fulfilled\".",
              "//Or, the patient does not have a previous encounter, i.e., there is no record in the encounterdim table with the same PatientKey, an EncounterStartDate before the //EventDate from the marketingeventfact table, and an encounter status of \"finished\".",
              "//If either a past appointment or encounter exists, the patient will not be included in the count of new patients.",
              "CALCULATETABLE (    ",
              "        // VALUES gets distinct values from the column  ",
              "        VALUES ( 'MarketingEventFact'[PatientKey] ),    ",
              "        // FILTER returns all rows from a table meeting the filter condition  ",
              "        FILTER (    ",
              "            'MarketingEventFact',    ",
              "            // Checks if PatientKey is not blank  ",
              "            NOT ( ISBLANK ( MarketingEventFact[PatientKey] ) )    ",
              "                && (    ",
              "                    // Calculate the number of rows in 'appointmentdim' where:  ",
              "                    CALCULATE (    ",
              "                        COUNTROWS ( 'AppointmentDim' ),    ",
              "                        FILTER (    ",
              "                            ALL ( 'AppointmentDim' ),    ",
              "                            // Ensures PatientKey is not blank  ",
              "                            NOT ( ISBLANK ( 'AppointmentDim'[PatientKey] ) )    ",
              "                                // Checks if PatientKey in 'appointmentdim' matches the earlier row context 'marketingeventfact'[PatientKey]  ",
              "                                && 'AppointmentDim'[PatientKey] = EARLIER ( 'MarketingEventFact'[PatientKey] )    ",
              "                                // Checks if AppointmentScheduledDate is less than the minimum EventDate  ",
              "                                && 'AppointmentDim'[AppointmentScheduledDate] < MIN ( 'MarketingEventFact'[EventDate] )    ",
              "                                // Checks if the status of the appointment is \"fulfilled\"  ",
              "                                 && (   ",
              "                                    VAR LookupResult =     ",
              "                                        LOOKUPVALUE ( 'AppointmentTransitionFact'[Status], 'AppointmentTransitionFact'[AppointmentKey], 'AppointmentDim'[AppointmentKey], \"True\" )    ",
              "                                    RETURN    ",
              "                                        IF (    ",
              "                                            LookupResult = \"True\",     ",
              "                                            TRUE,     ",
              "                                            LookupResult = \"fulfilled\"    ",
              "                                        )    ",
              "                                )       ",
              "                        )    ",
              "                    ) = 0    ",
              "                )    ",
              "                && (    ",
              "                    // Calculate the number of rows in 'encounterdim' where:  ",
              "                    CALCULATE (    ",
              "                        COUNTROWS ( 'EncounterDim' ),    ",
              "                        FILTER (    ",
              "                            'EncounterDim',    ",
              "                            // Ensures PatientKey is not blank  ",
              "                            NOT ( ISBLANK ( 'EncounterDim'[PatientKey] ) )    ",
              "                                // Checks if PatientKey in 'encounterdim' matches the earlier row context 'marketingeventfact'[PatientKey]  ",
              "                                && 'EncounterDim'[PatientKey] = EARLIER ( 'MarketingEventFact'[PatientKey] )    ",
              "                                // Checks if EncounterStartDate is less than the minimum EventDate  ",
              "                                && 'EncounterDim'[EncounterStartDate] < MIN ( 'MarketingEventFact'[EventDate] )    ",
              "                                // Checks if the status of the encounter is \"finished\"  ",
              "                                && 'EncounterDim'[EncounterStatus] = \"finished\"    ",
              "                        )    ",
              "                    ) = 0    ",
              "                )    ",
              "        )    ",
              "    )  ",
              "RETURN    CALCULATE(   ",
              "    DISTINCTCOUNT('MarketingEventFact'[PatientKey]),   ",
              "    FILTER(        ",
              "        ALLSELECTED(MarketingEventFact[PatientKey]), ",
              "        NOT(ISBLANK(MarketingEventFact[PatientKey])) && ",
              "        VAR CurrentPatientKey = MarketingEventFact[PatientKey]  ",
              "        VAR ServiceLineKeysList =    ",
              "        CALCULATETABLE (    ",
              "            VALUES ( JourneyDim[ServiceLineKey] ),    ",
              "            FILTER (    ",
              "                JourneyDim,    ",
              "                 IF(    ",
              "                                ISBLANK(SelectedJourneyKey),    ",
              "                                JourneyDim[JourneyKey] IN    ",
              "                    CALCULATETABLE (    ",
              "                        VALUES ( MarketingEventFact[JourneyKey] ) ,  ",
              "                        MarketingEventFact[EventDate] >= MinEventDate   ",
              "                    ),       ",
              "                                JourneyDim[JourneyKey] = SelectedJourneyKey    ",
              "                            )    ",
              "               ",
              "            )    ",
              "        )     ",
              "        RETURN        ",
              "        (       ",
              "            (      ",
              "                CALCULATE(          ",
              "    ALLSELECTED(AppointmentDim[PatientKey]),       ",
              "    FILTER(          ",
              "        AppointmentDim,      ",
              "          NOT(ISBLANK(AppointmentDim[PatientKey])) &&  ",
              "        AppointmentDim[PatientKey] = CurrentPatientKey      ",
              "        && AppointmentDim[AppointmentScheduledDate] <= MinEventDate     ",
              "        && (      ",
              "            IF(      ",
              "                ISBLANK(SelectedServiceLineKey),      ",
              "                AppointmentDim[ServiceLineKey] IN ServiceLineKeysList,      ",
              "                AppointmentDim[ServiceLineKey] = SelectedServiceLineKey      ",
              "            )      ",
              "        ",
              "        )    ",
              "    )          ",
              ")=0   ",
              "",
              "            )  && (      ",
              "                CALCULATE(        ",
              "                    ALLSELECTED(EncounterDim[PatientKey]),     ",
              "                    FILTER(        ",
              "                        EncounterDim,     ",
              "                        EncounterDim[PatientKey] = CurrentPatientKey    ",
              "                        && EncounterDim[EncounterStartDate] <= MinEventDate   ",
              "                         && (    ",
              "                            IF(    ",
              "                                ISBLANK(SelectedServiceLineKey),    ",
              "                                EncounterDim[ServiceLineKey] IN ServiceLineKeysList,    ",
              "                                EncounterDim[ServiceLineKey] = SelectedServiceLineKey    ",
              "                            )    ",
              "                     ",
              "                    )  ",
              "                    )        ",
              "                )=0    ",
              "            )  ",
              "        )  && NOT(CurrentPatientKey IN NewPatientIds )    ",
              "    )   ",
              ") ",
              ""
            ],
            "formatString": "0",
            "lineageTag": "9dde6abb-52d4-497f-ab1b-81187c9ee57a"
          },
          {
            "name": "PatientsInJourney",
            "description": "Total number of patients participating in the selected journeys during the selected time frame",
            "expression": [
              "",
              "VAR SummaryTable =   ",
              "    SUMMARIZE(       ",
              "        'MarketingEventFact',        ",
              "        'MarketingEventFact'[JourneyKey],       ",
              "        'MarketingEventFact'[PatientKey]       ",
              "    )  ",
              "RETURN  ",
              "    CALCULATE(    ",
              "        COUNTROWS(SummaryTable),    ",
              "        NOT(ISBLANK('MarketingEventFact'[PatientKey])) // Exclude records with null PatientKey    ",
              "    )    ",
              ""
            ],
            "formatString": "0",
            "lineageTag": "88f43cd6-78ff-4c41-969e-7f1ff7d7b60b"
          },
          {
            "name": "AppointmentsInfluencedByEmailActions",
            "description": "Total count of unique appointments that were scheduled following the event of opening an email or clicking an email",
            "expression": [
              "",
              "VAR SelectedOption = SELECTEDVALUE('AttributionModelDim'[AttributionModelKey], 2)          ",
              "VAR SelectedJourneyKey = SELECTEDVALUE('JourneyDim'[JourneyKey])         ",
              "VAR SelectedChannelKey = SELECTEDVALUE('MarketingChannelDim'[ChannelKey])         ",
              "VAR SelectedServiceLineKey = SELECTEDVALUE('ServiceLineDim'[ServiceLineKey])        ",
              "VAR SelectedChannelName = SELECTEDVALUE('MarketingChannelDim'[ChannelName], \"Email\")    ",
              "VAR MinEventDate = CALCULATE(MIN('MarketingEventFact'[EventDate]))    ",
              "// Calculate the number of Appointments Influenced by Email Actions    ",
              "// Check if the selected channel name is \"Email\"    ",
              "RETURN       ",
              "IF (SelectedChannelName = \"Email\",      ",
              "    // Calculate the distinct count of appointments based on the given conditions    ",
              "    CALCULATE (            ",
              "        DISTINCTCOUNT('MarketingEventFact'[AppointmentKey]),            ",
              "        FILTER (            ",
              "            ALLSELECTED('MarketingEventFact'),            ",
              "            NOT(ISBLANK(MarketingEventFact[PatientKey])) &&    ",
              "            NOT(ISBLANK(MarketingEventFact[AppointmentKey]))  &&    ",
              "            (            ",
              "                LOOKUPVALUE('MarketingChannelDim'[ChannelName], 'MarketingChannelDim'[ChannelKey], 'MarketingEventFact'[ChannelKey]) = SelectedChannelName ",
              "            ) &&    ",
              "            (ISBLANK(SelectedJourneyKey) || 'MarketingEventFact'[JourneyKey] = SelectedJourneyKey) &&    ",
              "            (ISBLANK(SelectedChannelKey) || 'MarketingEventFact'[ChannelKey] = SelectedChannelKey) &&    ",
              "            (ISBLANK(SelectedServiceLineKey) || RELATED(AppointmentDim[ServiceLineKey]) = SelectedServiceLineKey)        ",
              "  ",
              "            // Return the result based on the selected option    ",
              "            && IF(              ",
              "                SelectedOption = 1,  // Check if the selected option is 1            ",
              "                IF([RankingbyEventDate] = 1, 1, BLANK()),  // If selected option is 1, further check 'RankingbyEventDate'            ",
              "                1  // If selected option is not 1, return 1            ",
              "            )     ",
              "        )            ",
              "    ),      ",
              "    BLANK() // Return blank if SelectedChannelName is not \"Email\"      ",
              ")    ",
              ""
            ],
            "formatString": "0",
            "lineageTag": "a94afb02-2b1b-42c8-9f64-710b56c064b7"
          },
          {
            "name": "AppointmentsInfluencedBySMSActions",
            "description": "Total count of unique appointments scheduled after the sms delivery event or sms clicked event",
            "expression": [
              "",
              "VAR SelectedOption = SELECTEDVALUE('AttributionModelDim'[AttributionModelKey], 2)  ",
              "VAR SelectedJourneyKey = SELECTEDVALUE('JourneyDim'[JourneyKey])  ",
              "VAR SelectedChannelKey = SELECTEDVALUE('MarketingChannelDim'[ChannelKey])  ",
              "VAR SelectedServiceLineKey = SELECTEDVALUE('ServiceLineDim'[ServiceLineKey])  ",
              "VAR SelectedChannelName = SELECTEDVALUE('MarketingChannelDim'[ChannelName], \"Sms\")  ",
              "VAR MinEventDate = CALCULATE(MIN('MarketingEventFact'[EventDate]))  ",
              "// Calculate the number of Appointments Influenced by SMS Actions  ",
              "// Check if the selected channel name is \"Sms\"  ",
              "RETURN  ",
              "IF(  ",
              "    SelectedChannelName = \"Sms\",  ",
              "    // Calculate the distinct count of appointments based on the given conditions  ",
              "    CALCULATE(  ",
              "        DISTINCTCOUNT('MarketingEventFact'[AppointmentKey]),  ",
              "        FILTER(  ",
              "            ALLSELECTED('MarketingEventFact'),  ",
              "            NOT(ISBLANK(MarketingEventFact[AppointmentKey]))  ",
              "                && (LOOKUPVALUE('MarketingChannelDim'[ChannelName], 'MarketingChannelDim'[ChannelKey], 'MarketingEventFact'[ChannelKey]) = SelectedChannelName)  ",
              "                && (ISBLANK(SelectedJourneyKey) || 'MarketingEventFact'[JourneyKey] = SelectedJourneyKey)  ",
              "                && (ISBLANK(SelectedChannelKey) || 'MarketingEventFact'[ChannelKey] = SelectedChannelKey)  ",
              "                && (ISBLANK(SelectedServiceLineKey) || RELATED(AppointmentDim[ServiceLineKey]) = SelectedServiceLineKey)  ",
              "                // Return the result based on the selected option  ",
              "                && IF(  ",
              "                    SelectedOption = 1, // Check if the selected option is 1  ",
              "                    IF([RankingbyEventDate] = 1, 1, BLANK()), // If selected option is 1, further check 'RankingbyEventDate'  ",
              "                    1 // If selected option is not 1, return 1  ",
              "                )  ",
              "        )  ",
              "    ),  ",
              "    BLANK() // Return blank if SelectedChannelName is not \"Sms\"  ",
              ")  ",
              ""
            ],
            "formatString": "0",
            "lineageTag": "cbbd6dec-11d7-401f-bb61-860c607d5506"
          },
          {
            "name": "AppointmentsInfluencedByPushNotificationActions",
            "description": "Total count of unique appointments that were scheduled following the event of opening a push notification or clicking a push notification",
            "expression": [
              "",
              "VAR SelectedOption = SELECTEDVALUE('AttributionModelDim'[AttributionModelKey], 2)          ",
              "VAR SelectedJourneyKey = SELECTEDVALUE('JourneyDim'[JourneyKey])         ",
              "VAR SelectedChannelKey = SELECTEDVALUE('MarketingChannelDim'[ChannelKey])         ",
              "VAR SelectedServiceLineKey = SELECTEDVALUE('ServiceLineDim'[ServiceLineKey])        ",
              "VAR SelectedChannelName = SELECTEDVALUE('MarketingChannelDim'[ChannelName], \"PushNotification\")    ",
              "VAR MinEventDate = CALCULATE(MIN('MarketingEventFact'[EventDate]))    ",
              "// Calculate the number of Appointments Influenced by Email Actions    ",
              "// Check if the selected channel name is \"Email\"    ",
              "RETURN       ",
              "IF (SelectedChannelName = \"PushNotification\",      ",
              "    // Calculate the distinct count of appointments based on the given conditions    ",
              "    CALCULATE (            ",
              "        DISTINCTCOUNT('MarketingEventFact'[AppointmentKey]),            ",
              "        FILTER (            ",
              "            ALLSELECTED('MarketingEventFact'),            ",
              "            NOT(ISBLANK(MarketingEventFact[PatientKey])) &&    ",
              "            NOT(ISBLANK(MarketingEventFact[AppointmentKey])) &&    ",
              "            (            ",
              "                LOOKUPVALUE('MarketingChannelDim'[ChannelName], 'MarketingChannelDim'[ChannelKey], 'MarketingEventFact'[ChannelKey]) = SelectedChannelName   ",
              "                         ",
              "            ) &&    ",
              "            (ISBLANK(SelectedJourneyKey) || 'MarketingEventFact'[JourneyKey] = SelectedJourneyKey) &&    ",
              "            (ISBLANK(SelectedChannelKey) || 'MarketingEventFact'[ChannelKey] = SelectedChannelKey) &&    ",
              "            (ISBLANK(SelectedServiceLineKey) || RELATED(AppointmentDim[ServiceLineKey]) = SelectedServiceLineKey)        ",
              "  ",
              "            // Return the result based on the selected option    ",
              "            && IF(              ",
              "                SelectedOption = 1,  // Check if the selected option is 1            ",
              "                IF([RankingbyEventDate] = 1, 1, BLANK()),  // If selected option is 1, further check 'RankingbyEventDate'            ",
              "                1  // If selected option is not 1, return 1            ",
              "            )      ",
              "        )            ",
              "    ),      ",
              "    BLANK() // Return blank if SelectedChannelName is not \"Email\"      ",
              ")    ",
              ""
            ],
            "formatString": "0",
            "lineageTag": "88d5d5d4-6a07-45bb-a005-b44678675580"
          },
          {
            "name": "InfluencedAppointments",
            "expression": "[AppointmentsInfluencedByEmailActions] +[AppointmentsInfluencedByPushNotificationActions] +[AppointmentsInfluencedBySMSActions]",
            "formatString": "0",
            "lineageTag": "5959f894-7e94-4a85-9d20-c52c9a22c7c6"
          },
          {
            "name": "NewPatients",
            "description": [
              "Total number of patients with no prior appointments before the selected time period",
              ""
            ],
            "expression": [
              "",
              "// Calculate the minimum EventDate from the marketingeventfact table  ",
              "VAR MinEventDate =  ",
              "    MIN ( 'MarketingEventFact'[EventDate] )  ",
              "  ",
              "// Get the distinct PatientKeys from the marketingeventfact table where PatientKey is not blank  ",
              "VAR FilteredPatientKeys =  ",
              "    CALCULATETABLE (  ",
              "        DISTINCT ( 'MarketingEventFact'[PatientKey] ),  ",
              "        NOT ( ISBLANK ( 'MarketingEventFact'[PatientKey] ) )  ",
              "    )  ",
              "  ",
              "// Get the distinct PatientKeys from the appointmentdim table where PatientKey is not blank,  ",
              "// AppointmentScheduledDate is less than MinEventDate, and appointment status is \"fulfilled\"  ",
              "VAR FilteredAppointments =  ",
              "    CALCULATETABLE (  ",
              "        DISTINCT ( 'AppointmentDim'[PatientKey] ),  ",
              "        NOT ( ISBLANK ( 'AppointmentDim'[PatientKey] ) ),  ",
              "        'AppointmentDim'[AppointmentScheduledDate] < MinEventDate,  ",
              "        TREATAS (  ",
              "            CALCULATETABLE (  ",
              "                VALUES ( 'AppointmentTransitionFact'[AppointmentKey] ),  ",
              "                'AppointmentTransitionFact'[Status] = \"fulfilled\"  ",
              "            ),  ",
              "            'AppointmentDim'[AppointmentKey]  ",
              "        )  ",
              "    )  ",
              "  ",
              "// Get the distinct PatientKeys from the encounterdim table where PatientKey is not blank,  ",
              "// EncounterStartDate is less than MinEventDate, and encounter status is \"finished\"  ",
              "VAR FilteredEncounters =  ",
              "    CALCULATETABLE (  ",
              "        DISTINCT ( 'EncounterDim'[PatientKey] ),  ",
              "        NOT ( ISBLANK ( 'EncounterDim'[PatientKey] ) ),  ",
              "        'EncounterDim'[EncounterStartDate] < MinEventDate,  ",
              "        'EncounterDim'[EncounterStatus] = \"finished\"  ",
              "    )  ",
              "  ",
              "// Subtract the union of FilteredAppointments and FilteredEncounters from FilteredPatientKeys  ",
              "// to get the new patient keys  ",
              "VAR NewPatientKeys =  ",
              "    EXCEPT (  ",
              "        FilteredPatientKeys,  ",
              "        UNION ( FilteredAppointments, FilteredEncounters )  ",
              "    )  ",
              "  ",
              "// Return the number of rows in the NewPatientKeys variable (i.e., the count of new patients)  ",
              "RETURN  ",
              "    COUNTROWS ( NewPatientKeys )  ",
              ""
            ],
            "formatString": "0",
            "lineageTag": "905330b4-0740-4286-b279-cfb08a4ebf67"
          },
          {
            "name": "BookedAppointments",
            "description": "This represents the total count of unique appointments, with the status \"booked\", which were scheduled during selected time period,",
            "expression": [
              "",
              "CALCULATE(  ",
              "    DISTINCTCOUNT('MarketingEventFact'[AppointmentKey]),  ",
              "    // Filter the rows in the 'appointmenttransitionfact' table where Status is \"booked\"  ",
              "    'AppointmentTransitionFact'[Status] = \"booked\",  ",
              "    // Filter the rows in the 'appointmentDim' table where AppointmentScheduledDate is greater than or equal to the minimum EventDate in the 'marketingeventfact' table  ",
              "    'AppointmentDim'[AppointmentScheduledDate] >= MIN('MarketingEventFact'[EventDate])  ",
              ")  ",
              ""
            ],
            "formatString": "0",
            "lineageTag": "64c67cc7-a7f0-4c3b-a737-cf1f5ee5a9ef"
          },
          {
            "name": "NewPatientsToServiceLine",
            "description": [
              "Total count of patients without previous appointments for the same service line prior before the selected time frame.",
              ""
            ],
            "expression": [
              "",
              "IF (  ",
              "    ISBLANK ( [PatientsWithNewServiceline] ),  ",
              "    [NewPatients],  ",
              "    [PatientsWithNewServiceline] + [NewPatients]  ",
              ")  ",
              ""
            ],
            "formatString": "0",
            "lineageTag": "3c4b164d-1933-4bb9-83d0-21eed8d02943"
          },
          {
            "name": "CompletedAppointments",
            "description": "The number of individual appointments scheduled within the chosen timeframe that have been booked and subsequently fulfilled or proposed.",
            "expression": [
              "",
              "CALCULATE(  ",
              "    DISTINCTCOUNT('MarketingEventFact'[AppointmentKey]),  ",
              "    // Filter the rows in the 'appointmenttransitionfact' table where Status is \"booked\"  ",
              "    'AppointmentTransitionFact'[Status] = \"fulfilled\",  ",
              "    // Filter the rows in the 'appointmentDim' table where AppointmentScheduledDate is greater than or equal to the minimum EventDate in the 'marketingeventfact' table  ",
              "    'AppointmentDim'[AppointmentScheduledDate] >= MIN('MarketingEventFact'[EventDate])  ",
              ")  ",
              ""
            ],
            "formatString": "0",
            "lineageTag": "97f49047-870b-4590-b788-28e365dfaed4"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          }
        ]
