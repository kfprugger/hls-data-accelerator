{
    "name": "omop_analytics_e2e",
    "description": "An integration test for omop analytics",
    "initial_context": {
        "targetEnvironment": "msit",
        "workspaceDisplayName": "HDS_IT_OMOP",
        "uniquePrefix": "healthcare1",
        "dist_path": "dist",
        "validation_notebooks_path": "src/tools/automation/AutomationFramework/resources/notebooks/omop"
    },
    "tasks": [
        {
            "type": "CreateWorkspace",
            "description": "Creating a new test workspace",
            "parameters": {
                "displayName": "$workspaceDisplayName",
                "description": "A test ws",
                "add_datetime_postfix": true
            },
            "outputs": [
                "workspace",
                "capacityId"
            ]
        },
        {
            "type": "CreateHdsItem",
            "description": "Create a new hds item",
            "parameters": {
                "workspace": "$workspace",
                "solution_display_name": "healthcare1"
            },
            "outputs": [
                "solution_artifact_id"
            ]
        },
        {
            "type": "DeployHdsCapabilities",
            "description": "Deploy foundations capablity",
            "parameters": {
                "capacityId": "$capacityId",
                "workspace": "$workspace",
                "solution_artifact_id": "$solution_artifact_id",
                "capabilities": [
                    {
                        "capabilityKey":"relational-fhir-data-foundations",
                        "userParameters":[]
                    },
                    {
                        "capabilityKey":"sample-data",
                        "userParameters":[]
                    },
                    {
                        "capabilityKey": "omop-analytics",
                        "userParameters": []
                    }
                ],
                "uniquePrefix": "$uniquePrefix"
            },
            "outputs": []
        },
        {
            "type": "PollCapabilityDeployment",
            "description": "Poll capability deployment",
            "parameters": {
                "capacityId": "$capacityId",
                "workspace": "$workspace",
                "solution_artifact_id": "$solution_artifact_id"
            },
            "outputs": []
        },
        {
            "type": "GetSolutionEnvironment",
            "description": "Get deployed environment",
            "parameters": {
                "workspace": "$workspace",
                "uniquePrefix": "$uniquePrefix"
            },
            "outputs": [
                "environment"
            ]
        },
        {
            "type": "GetSolutionLakehouse",
            "description": "Add deployed bronze lakehouse to the runtime context",
            "parameters": {
                "workspace": "$workspace",
                "lakehouse_name": "bronze",
                "uniquePrefix": "$uniquePrefix"
            },
            "outputs": [
                "bronze_lakehouse"
            ]
        },
        {
            "type": "GetSolutionLakehouse",
            "description": "Add deployed omop lakehouse to the runtime context",
            "parameters": {
                "workspace": "$workspace",
                "lakehouse_name": "gold_omop",
                "uniquePrefix": "$uniquePrefix"
            },
            "outputs": [
                "omop_lakehouse"
            ]
        },
        {
            "type": "RemoveEnvironmentLibraries",
            "description": "Removing libraries from default environment",
            "parameters": {
                "workspace": "$workspace",
                "environment": "$environment"
            }
        },
        {
            "type": "PublishEnvironment",
            "description": "Publishing an environment with local libraries",
            "parameters": {
                "workspace": "$workspace",
                "environment": "$environment",
                "dist_path": "$dist_path",
                "libraries_relative_path": "/healthcare-libraries/1.1.0/",
                "environment_yml_path": "src/tools/automation/AutomationFramework/resources/configs/environment.yml"
            },
            "outputs": []
        },
        {
            "type": "CreateLakehouse",
            "description": "Creating a Test lakehouse",
            "parameters": {
                "displayName": "Test",
                "description": "A lakehouse for test artifacts",
                "workspace": "$workspace",
                "subfolders": []
            },
            "outputs": [
                "test_lakehouse"
            ]
        },
        {
            "type": "SetupNotebook",
            "description": "Setting up notebook to copy sample data",
            "parameters": {
                "workspace": "$workspace",
                "environment": "$environment",
                "notebooks_path": "/src/tools/automation/AutomationFramework/resources/notebooks/",
                "notebookName": "copy_folder.ipynb",
                "lakehouseConfig": {
                  "default_lakehouse_name": "healthcare1_msft_bronze",
                  "known_lakehouses": [
                    "healthcare1_msft_bronze"
                  ]
                },
                "notebook_parameters": {
                    "workspace_id": "%%workspace_id%%",
                    "lakehouse_id": "%%bronze_lakehouse_id%%",
                    "source_path": "/Files/SampleData/Clinical/FHIR-NDJSON/FHIR-HDS/51KSyntheticPatients",
                    "destination_directory_path": "/Files/Ingest/Clinical/FHIR-NDJSON/FHIR-HDS/",
                    "action": "copy"
                }            
            },
            "outputs": [
                "copy_sample_data_notebook_id"
            ]
        },
        {
            "type": "UpdateDttConfig",
            "description": "Update Dtt config with local versions",
            "parameters": {
                "workspace": "$workspace",
                "soluation_artifact_id": "$solution_artifact_id",
                "dtt_config_path" : "/src/config/fhir4/transformation/omop"
            }
        },
        {
            "type": "RunNotebook",
            "description": "Running copy sample data notebook",
            "parameters": {
                "workspace": "$workspace",
                "environment": "$environment",
                "notebook_id": "$copy_sample_data_notebook_id",
                "default_lakehouse": "$bronze_lakehouse"
            },
            "outputs": [
                "copy_sample_data_notebook_run_id"
            ]
        },
        {
            "type": "PollJobCompletion",
            "description": "Polling copy sample data notebook completion",
            "parameters": {
                "workspace": "$workspace",
                "item_id": "$copy_sample_data_notebook_id",
                "job_id": "$copy_sample_data_notebook_run_id"
            }
        },
        {
            "type": "WaitForEnvironmentPublish",
            "description": "Waiting for test env to publish",
            "parameters": {
                "workspace": "$workspace",
                "environment": "$environment"
            }
        },
        {
            "type": "RunDataPipeline",
            "description": "Running Omop analytics pipelines",
            "parameters": {
                "workspace": "$workspace",
                "dataPipelineName": "healthcare1_msft_omop_analytics",
                "pipelineParameters": {}
            },
            "outputs": [
                "data_pipeline_id",
                "pipeline_run_id"
            ]
        },
        {
            "type": "PollDataPipeline",
            "description": "Poll data pipeline completion",
            "ignore": "false",
            "parameters": {
                "workspace": "$workspace",
                "item_id": "$data_pipeline_id",
                "job_id": "$pipeline_run_id"
            },
            "outputs": [
                "data_pipeline_activity_details"
            ]
        },
        {
            "type": "SetupNotebook",
            "description": "Setting up bronze ingestion tests notebook",
            "parameters": {
                "workspace": "$workspace",
                "environment": "$environment",
                "notebooks_path": "$validation_notebooks_path",
                "notebookName": "omop_data_validation_tests.ipynb",
                "lakehouseConfig": {
                  "default_lakehouse_name": "healthcare1_msft_gold_omop",
                  "known_lakehouses": [
                    "healthcare1_msft_gold_omop"
                  ]
                },
                "notebook_parameters": {
                    "workspace_id": "%%workspace_id%%",
                    "destination_lakehouse_id": "%%test_lakehouse_id%%",
                    "destination_lakehouse_path": "Files/Tests/omop/omop_data_validation_tests_results.xml",
                    "deployment_environment": "$targetEnvironment"
                  }
            }, 
            "outputs": [
                "omop_data_validation_tests_notebook_id"
            ]
        },
        {
            "type": "SetupNotebook",
            "description": "Setting up Omop deployment tests notebook",
            "parameters": {
                "workspace": "$workspace",
                "environment": "$environment",
                "notebooks_path": "$validation_notebooks_path",
                "notebookName": "omop_deployment_tests.ipynb",
                "lakehouseConfig": {
                  "default_lakehouse_name": "healthcare1_msft_gold_omop",
                  "known_lakehouses": [
                    "healthcare1_msft_gold_omop"
                  ]
                },
                "notebook_parameters": {
                  "workspace_id": "%%workspace_id%%",
                  "bronze_lakehouse_id": "%%bronze_lakehouse_id%%",
                  "destination_lakehouse_id": "%%test_lakehouse_id%%",
                  "destination_lakehouse_path": "Files/Tests/omop/omop_deployment_test_results.xml",
                  "expected_installed_capabilities" : { "relational-fhir-data-foundations": "1.1.0", "sample-data": "1.0.0", "omop-analytics": "1.0.0" },
                  "pipeline_run_id": "$pipeline_run_id",
                  "prefix": "$uniquePrefix",
                  "deployment_environment": "$targetEnvironment"
                }
            }, 
            "outputs": [
                "omop_deployment_tests_notebook_id"
            ]
        },
        {
            "type": "RunNotebook",
            "ignore": "false",
            "description": "Running omop data validation tests notebook",
            "parameters": {
                "workspace": "$workspace",
                "environment": "$environment",
                "notebook_id": "$omop_data_validation_tests_notebook_id",
                "default_lakehouse": "$omop_lakehouse"
            },
            "outputs": [
                "omop_data_validation_tests_notebook_run_id"
            ]
        },
        {
            "type": "RunNotebook",
            "ignore": "false",
            "description": "Running deployment tests notebook",
            "parameters": {
                "workspace": "$workspace",
                "environment": "$environment",
                "notebook_id": "$omop_deployment_tests_notebook_id",
                "default_lakehouse": "$omop_lakehouse"
            },
            "outputs": [
                "omop_deployment_tests_notebook_run_id"
            ]
        },
        {
            "type": "PollJobCompletion",
            "ignore": "false",
            "description": "Polling Omop deployment notebook completion",
            "parameters": {
                "workspace": "$workspace",
                "item_id": "$omop_deployment_tests_notebook_id",
                "job_id": "$omop_deployment_tests_notebook_run_id"
            }
        },
        {
            "type": "PollJobCompletion",
            "ignore": "false",
            "description": "Polling Omop data validation notebook completion",
            "parameters": {
                "workspace": "$workspace",
                "item_id": "$omop_data_validation_tests_notebook_id",
                "job_id": "$omop_data_validation_tests_notebook_run_id"
            }
        },
        {
            "type": "ParseTestResults",
            "ignore": "false",
            "description": "Polling Omop data validation notebook completion",
            "parameters": {
                "workspace": "$workspace",
                "lakehouse": "$test_lakehouse",
                "deployment_environment": "$targetEnvironment",
                "test_name": "OMOP Integration"
            }
        }
    ]
}