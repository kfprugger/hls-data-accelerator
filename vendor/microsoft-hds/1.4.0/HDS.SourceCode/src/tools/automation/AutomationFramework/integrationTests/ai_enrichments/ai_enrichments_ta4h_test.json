{
    "name": "AI Enrichments Test",
    "description": "An integration test for AI enrichments against deployed environment only",
    "initial_context": {
        "targetEnvironment": "dxt",
        "workspaceDisplayName": "HDS_AIE_TA4H_IT",
        "uniquePrefix": "healthcare1",
        "dist_path": "dist",
        "validation_notebooks_path": "src/tools/automation/AutomationFramework/resources/notebooks/ai_enrichments"
        
    },
    "tasks": [
        {
            "type": "CreateWorkspace",
            "description": "Creating a new test workspace",
            "parameters": {
                "displayName": "$workspaceDisplayName",
                "description": "A test for AI Enrichments",
                "add_datetime_postfix": "true"
            },
            "outputs": [
                "workspace",
                "capacityId"
            ]
        },
        {
            "type": "CreateHdsItem",
            "description": "Create a new hds item",
            "parameters": {
                "workspace": "$workspace",
                "solution_display_name": "healthcare1"
            },
            "outputs": [
                "solution_artifact_id"
            ]
        },
        {
            "type": "DeployHdsCapabilities",
            "description": "Deploy AI enrichments capablity",
            "parameters": {
                "capacityId": "$capacityId",
                "workspace": "$workspace",
                "solution_artifact_id": "$solution_artifact_id",
                "uniquePrefix": "$uniquePrefix",
                "capabilities": [
                    {
                        "capabilityKey": "relational-fhir-data-foundations",
                        "userParameters": []
                    },
                    {
                        "capabilityKey":"sample-data",
                        "userParameters":[]
                    },
                    {
                        "capabilityKey": "ai-enrichments",
                        "userParameters": [
                            {
                                "name": "keyvault_name",
                                "value": "dmh-dev-sharedkv",
                                "type": "Global"
                            }
                        ]
                    }
                ]
            },
            "outputs": []
        },
        {
            "type": "PollCapabilityDeployment",
            "description": "Poll capability deployment",
            "parameters": {
                "capacityId": "$capacityId",
                "workspace": "$workspace",
                "solution_artifact_id": "$solution_artifact_id"
            },
            "outputs": []
        },
        {
            "type": "PublishEnvironment",
            "description": "Creating an environment used by test notebooks",
            "ignore": "false",
            "parameters": {
                "displayName": "TestEnvironment",
                "dist_path": "$dist_path",
                "workspace": "$workspace",
                "upload_local_libraries": false,
                "environment_yml_path": "src/tools/automation/AutomationFramework/resources/configs/environment.yml"
            },
            "outputs": [
                "test_environment"
            ]
        },
        {
            "type": "GetSolutionEnvironment",
            "description": "Get deployed environment",
            "parameters": {
                "workspace": "$workspace",
                "uniquePrefix": "$uniquePrefix"
            },
            "outputs": [
                "solution_environment"
            ]
        },
        {
            "type": "GetSolutionLakehouse",
            "description": "Add deployed bronze lakehouse to the runtime context",
            "parameters": {
                "workspace": "$workspace",
                "lakehouse_name": "bronze",
                "uniquePrefix": "$uniquePrefix"
            },
            "outputs": [
                "bronze_lakehouse"
            ]
        },
        {
            "type": "CreateLakehouse",
            "description": "Creating a Test lakehouse",
            "ignore": "false",
            "parameters": {
                "displayName": "Test",
                "description": "A lakehouse for test artifacts",
                "workspace": "$workspace",
                "subfolders": []
            },
            "outputs": [
                "test_lakehouse"
            ]
        },
        {
            "type": "SetupNotebook",
            "description": "Setting up ai enrichments ta4h test notebook",
            "ignore": "false",
            "parameters": {
                "workspace": "$workspace",
                "environment": "$test_environment",
                "notebooks_path": "$validation_notebooks_path",
                "notebookName": "ai_enrichments_ta4h_tests.ipynb",
                "lakehouseConfig": {
                  "default_lakehouse_name": "healthcare1_msft_bronze",
                  "known_lakehouses": [
                    "healthcare1_msft_bronze"
                  ]
                },
                "notebook_parameters": {
                  "workspace_id": "%%workspace_id%%",
                  "bronze_lakehouse_id": "%%bronze_lakehouse_id%%",
                  "destination_lakehouse_id": "%%test_lakehouse_id%%",
                  "destination_lakehouse_path": "Files/Tests/AI_Enrichments/ai_enrichments_ta4h_deployment_tests_results.xml",
                  "deployment_environment": "$targetEnvironment",
                  "prefix": "$uniquePrefix",
                  "expected_installed_capabilities" : { "relational-fhir-data-foundations": "1.2.0", "sample-data": "1.2.0", "ai-enrichments": "1.2.0" }
                }
            }, 
            "outputs": [
                "ai_enrichments_ta4h_deployment_tests_notebook_id"
            ]
        },
        {
            "type": "SetupNotebook",
            "description": "Setting up ai enrichments ta4h test notebook",
            "ignore": "false",
            "parameters": {
                "workspace": "$workspace",
                "environment": "$test_environment",
                "notebooks_path": "$validation_notebooks_path",
                "notebookName": "ai_enrichments_ta4h_validation_tests.ipynb",
                "lakehouseConfig": {
                    "default_lakehouse_name": "healthcare1_msft_bronze",
                    "known_lakehouses": [
                        "healthcare1_msft_bronze"
                    ]
                },
                "notebook_parameters": {
                    "workspace_id": "%%workspace_id%%",
                    "bronze_lakehouse_id": "%%bronze_lakehouse_id%%",
                    "destination_lakehouse_id": "%%test_lakehouse_id%%",
                    "destination_lakehouse_path": "Files/Tests/AI_Enrichments/ai_enrichments_ta4h_validation_tests_results.xml",
                    "prefix": "$uniquePrefix"
                 }
            },
            "outputs": [
                "ai_enrichments_ta4h_validation_tests_notebook_id"
            ]
        },
        {
            "type": "SetupNotebook",
            "description": "Setting up notebook to copy sample data",
            "ignore": "false",
            "parameters": {
                "workspace": "$workspace",
                "environment": "$solution_environment",
                "notebooks_path": "/src/tools/automation/AutomationFramework/resources/notebooks/",
                "notebookName": "copy_folder.ipynb",
                "lakehouseConfig": {
                  "default_lakehouse_name": "healthcare1_msft_bronze",
                  "known_lakehouses": [
                    "healthcare1_msft_bronze"
                  ]
                },
                "notebook_parameters": {
                    "workspace_id": "%%workspace_id%%",
                    "lakehouse_id": "%%bronze_lakehouse_id%%",
                    "source_path": "/Files/SampleData/Clinical/FHIR-NDJSON/FHIR-HDS/51KSyntheticPatients",
                    "destination_directory_path": "/Files/Ingest/Clinical/FHIR-NDJSON/FHIR-HDS/",
                    "action": "copy"
                }            
            },
            "outputs": [
                "copy_sample_data_notebook_id"
            ]
        },
        {
            "type": "RunNotebook",
            "description": "Running copy sample data notebook",
            "parameters": {
                "workspace": "$workspace",
                "environment": "$solution_environment",
                "notebook_id": "$copy_sample_data_notebook_id",
                "default_lakehouse": "$bronze_lakehouse"
            },
            "outputs": [
                "copy_sample_data_notebook_run_id"
            ]
        },
        {
            "type": "PollJobCompletion",
            "description": "Polling copy sample data notebook completion",
            "parameters": {
                "workspace": "$workspace",
                "item_id": "$copy_sample_data_notebook_id",
                "job_id": "$copy_sample_data_notebook_run_id"
            }
        },
        {
            "type": "UpdateNotebookVariables",
            "description": "Updating notebook variables",
            "parameters": {
                "workspace": "$workspace",
                "notebookName": "msft_ai_enrichments_ta4h_execution",
                "notebook_variables": {
                    "TA4H_API_KEY_SECRET_NAME" : "api-key-ta4h",
                    "TA4H_API_ENDPOINT" : "https://haidas-language-services-dev-oz.cognitiveservices.azure.com/",
                    "TA4H_API_VERSION": "2023-11-15-preview"
                }
            },
            "outputs": [
                "ai_enrichments_ta4h_execution_notebook_id"
            ]
        },
        {
            "type": "WaitForEnvironmentPublish",
            "description": "Waiting for test env to publish",
            "parameters": {
                "workspace": "$workspace",
                "environment": "$solution_environment"
            }
        },
        {
            "type": "RunDataPipeline",
            "description": "Running data foundations pipelines",
            "ignore": "false",
            "parameters": {
                "workspace": "$workspace",
                "dataPipelineName": "healthcare1_msft_clinical_data_foundation_ingestion",
                "pipelineParameters": {}
            },
            "outputs": [
                "data_foundations_data_pipeline_id",
                "data_foundations_pipeline_run_id"
            ]
        },
        {
            "type": "PollDataPipeline",
            "description": "Poll data pipeline completion",
            "ignore": "false",
            "parameters": {
                "workspace": "$workspace",
                "item_id": "$data_foundations_data_pipeline_id",
                "job_id": "$data_foundations_pipeline_run_id"
            },
            "outputs": [
                "data_foundations_pipeline_activity_details"
            ]
        },
        {
            "type": "RunNotebook",
            "description": "Running copy sample data notebook",
            "parameters": {
                "workspace": "$workspace",
                "environment": "$solution_environment",
                "notebook_id": "$ai_enrichments_ta4h_execution_notebook_id",
                "default_lakehouse": "$bronze_lakehouse"
            },
            "outputs": [
                "ai_enrichments_ta4h_execution_notebook_run_id"
            ]
        },
        {
            "type": "PollJobCompletion",
            "description": "Polling copy sample data notebook completion",
            "parameters": {
                "workspace": "$workspace",
                "item_id": "$ai_enrichments_ta4h_execution_notebook_id",
                "job_id": "$ai_enrichments_ta4h_execution_notebook_run_id"
            }
        },
        {
            "type": "RunDataPipeline",
            "description": "Running data foundations pipelines",
            "ignore": "false",
            "parameters": {
                "workspace": "$workspace",
                "dataPipelineName": "healthcare1_msft_ai_enrichments_ingestion",
                "pipelineParameters": {}
            },
            "outputs": [
                "ai_enrichments_pipeline_id",
                "ai_enrichments_pipeline_run_id"
            ]
        },
        {
            "type": "PollDataPipeline",
            "description": "Poll ai enrichments data pipeline completion",
            "ignore": "false",
            "parameters": {
                "workspace": "$workspace",
                "item_id": "$ai_enrichments_pipeline_id",
                "job_id": "$ai_enrichments_pipeline_run_id"
            },
            "outputs": [
                "ai_enrichments_pipeline_activity_details"
            ]
        },
        {
            "type": "RunNotebook",
            "description": "Running deployment tests notebook",
            "parameters": {
                "workspace": "$workspace",
                "environment": "$test_environment",
                "notebook_id": "$ai_enrichments_ta4h_deployment_tests_notebook_id",
                "default_lakehouse": "$bronze_lakehouse"
            },
            "outputs": [
                "ai_enrichments_ta4h_deployment_tests_notebook_run_id"
            ]
        },
        {
            "type": "RunNotebook",
            "description": "Running data validation tests notebook",
            "parameters": {
                "workspace": "$workspace",
                "environment": "$test_environment",
                "notebook_id": "$ai_enrichments_ta4h_validation_tests_notebook_id",
                "default_lakehouse": "$bronze_lakehouse"
            },
            "outputs": [
                "ai_enrichments_ta4h_validation_tests_notebook_run_id"
            ]
        },
        {
            "type": "PollJobCompletion",
            "description": "Polling deployment test notebook completion",
            "parameters": {
                "workspace": "$workspace",
                "item_id": "$ai_enrichments_ta4h_deployment_tests_notebook_id",
                "job_id": "$ai_enrichments_ta4h_deployment_tests_notebook_run_id"
            }
        },
        {
            "type": "PollJobCompletion",
            "description": "Polling validation test notebook completion",
            "parameters": {
                "workspace": "$workspace",
                "item_id": "$ai_enrichments_ta4h_validation_tests_notebook_id",
                "job_id": "$ai_enrichments_ta4h_validation_tests_notebook_run_id"
            }
        },
        {
            "type": "ParseTestResults",
            "description": "Polling AI Enrichments TA4H data notebook completion",
            "parameters": {
                "workspace": "$workspace",
                "lakehouse": "$test_lakehouse",
                "deployment_environment": "$targetEnvironment",
                "test_name": "AI Enrichments TA4H Integration"
            }
        }
        
    ]
}
