{
    "name": "DAX Conversational Data Enrichments",
    "description": "An integration test for DAX conversational data enrichments against deployed environment only",
    "initial_context": {
        "targetEnvironment": "MSIT",
        "workspaceDisplayName": "HDS_DAX_IT",
        "uniquePrefix": "healthcare1",
        "dist_path": "dist"
    },
    "tasks": [
        {
            "type": "CreateWorkspace",
            "description": "Creating a new test workspace",
            "parameters": {
                "displayName": "$workspaceDisplayName",
                "description": "A test for DAX",
                "add_datetime_postfix": "true"
            },
            "outputs": [
                "workspace",
                "capacityId"
            ]
        },
        {
            "type": "CreateHdsItem",
            "description": "Create a new hds item",
            "parameters": {
                "workspace": "$workspace",
                "solution_display_name": "healthcare1"
            },
            "outputs": [
                "solution_artifact_id"
            ]
        },
        {
            "type": "DeployHdsCapabilities",
            "description": "Deploy DAX conversation enrichments capablity",
            "parameters": {
                "capacityId": "$capacityId",
                "workspace": "$workspace",
                "solution_artifact_id": "$solution_artifact_id",
                "uniquePrefix": "$uniquePrefix",
                "capabilities": [
                    {
                        "capabilityKey": "relational-fhir-data-foundations",
                        "userParameters": []
                    },
                    {
                        "capabilityKey": "dax-conversational-data-enrichments",
                        "userParameters": [
                            {
                                "name": "keyvault_name",
                                "value": "dmh-dev-sharedkv",
                                "type": "Global"
                            },
                            {
                                "name": "azure_open_ai_model_name",
                                "value": "gpt-4o-3",
                                "type": "Local"
                            },
                            {
                                "name": "azure_open_ai_api_version",
                                "value": "2024-08-01-preview",
                                "type": "Local"
                            },
                            {
                                "name": "dax_landing_zone_lakehouse_id",
                                "value": "",
                                "type": "Local"
                            }
                        ]
                    }
                ]
            },
            "outputs": []
        },
        {
            "type": "PollCapabilityDeployment",
            "description": "Poll capability deployment",
            "parameters": {
                "capacityId": "$capacityId",
                "workspace": "$workspace",
                "solution_artifact_id": "$solution_artifact_id"
            },
            "outputs": []
        },
        {
            "type": "PublishEnvironment",
            "description": "Creating an environment used by test notebooks",
            "ignore": "false",
            "parameters": {
                "displayName": "TestEnvironment",
                "dist_path": "$dist_path",
                "workspace": "$workspace",
                "upload_local_libraries": false,
                "environment_yml_path": "src/tools/automation/AutomationFramework/resources/configs/environment.yml"
            },
            "outputs": [
                "test_environment"
            ]
        },
        {
            "type": "GetSolutionLakehouse",
            "description": "Add deployed bronze lakehouse to the runtime context",
            "parameters": {
                "workspace": "$workspace",
                "lakehouse_name": "bronze",
                "uniquePrefix": "$uniquePrefix"
            },
            "outputs": [
                "bronze_lakehouse"
            ]
        },
        {
            "type": "CopyFromStorageAccount",
            "description": "Copy sample data into Bronze Lakehouse",
            "parameters": {
                "workspace": "$workspace",
                "blob_storage_account_url": "https://dmhdevsharedsa.blob.core.windows.net/",
                "container_name": "sample-data",
                "source_subpath": "dax_copilot_data/2024/7/5/encounters/c1d65033-286e-4380-a88b-beb014f6a0e5/Transcripts",
                "destination_lakehouse_name": "healthcare1_msft_bronze",
                "destination_subpath": "Files/External/DaxCopilot/dax_copilot_data/2024/7/5/encounters/c1d65033-286e-4380-a88b-beb014f6a0e5/Transcripts"
            }
        },
        {
            "type": "CopyFromStorageAccount",
            "description": "Copy sample data into Bronze Lakehouse",
            "parameters": {
                "workspace": "$workspace",
                "blob_storage_account_url": "https://dmhdevsharedsa.blob.core.windows.net/",
                "container_name": "sample-data",
                "source_subpath": "dax_copilot_data/2024/10/08/encounters/03AFD6E3-6BEB-425B-8C09-BC444E426EFB-f67f9862-eb9f-4459-8e9c-1975b19422e3/Transcripts",
                "destination_lakehouse_name": "healthcare1_msft_bronze",
                "destination_subpath": "Files/External/DaxCopilot/dax_copilot_data/2024/10/08/encounters/03AFD6E3-6BEB-425B-8C09-BC444E426EFB-f67f9862-eb9f-4459-8e9c-1975b19422e3/Transcripts"
            }
        },
        {
            "type": "CreateLakehouse",
            "description": "Creating a Test lakehouse",
            "ignore": "false",
            "parameters": {
                "displayName": "Test",
                "description": "A lakehouse for test artifacts",
                "workspace": "$workspace",
                "subfolders": []
            },
            "outputs": [
                "test_lakehouse"
            ]
        },
        {
            "type": "SetupNotebook",
            "description": "Setting up DAX deployment tests notebook",
            "ignore": "false",
            "parameters": {
                "workspace": "$workspace",
                "environment": "$test_environment",
                "notebooks_path": "src/tools/automation/AutomationFramework/resources/notebooks/dax",
                "notebookName": "dax_conversational_data_enrichments_deployment_tests.ipynb",
                "lakehouseConfig": {
                  "default_lakehouse_name": "healthcare1_msft_bronze",
                  "known_lakehouses": [
                    "healthcare1_msft_bronze"
                  ]
                },
                "notebook_parameters": {
                  "workspace_id": "%%workspace_id%%",
                  "bronze_lakehouse_id": "%%bronze_lakehouse_id%%",
                  "destination_lakehouse_id": "%%test_lakehouse_id%%",
                  "destination_lakehouse_path": "Files/Tests/DAX/dax_conversational_data_enrichments_deployment_test_results.xml",
                  "deployment_environment": "$targetEnvironment",
                  "prefix": "$uniquePrefix",
                  "expected_installed_capabilities" : { "relational-fhir-data-foundations": "1.2.0", "dax-conversational-data-enrichments": "1.2.0" }
                }
            }, 
            "outputs": [
                "dax_conversational_data_enrichments_deployment_test_notebook_id"
            ]
        },
        {
            "type": "SetupNotebook",
            "description": "Setting up DAX data validation notebook",
            "ignore": "false",
            "parameters": {
                "workspace": "$workspace",
                "environment": "$test_environment",
                "notebooks_path": "src/tools/automation/AutomationFramework/resources/notebooks/dax",
                "notebookName": "dax_conversational_data_validation_tests.ipynb",
                "lakehouseConfig": {
                    "default_lakehouse_name": "healthcare1_msft_bronze",
                    "known_lakehouses": [
                        "healthcare1_msft_bronze"
                    ]
                },
                "notebook_parameters": {
                    "workspace_id": "%%workspace_id%%",
                    "bronze_lakehouse_id": "%%bronze_lakehouse_id%%",
                    "destination_lakehouse_id": "%%test_lakehouse_id%%",
                    "destination_lakehouse_path": "Files/Tests/DAX/dax_conversational_data_validation_test_results.xml",
                    "databases": "healthcare1_msft_silver",
                    "deployment_environment": "$targetEnvironment"
                }
            },
            "outputs": [
                "dax_conversational_data_validation_test_notebook_id"
            ]
        },
        {
            "type": "WaitForEnvironmentPublish",
            "description": "Waiting for test env to publish",
            "parameters": {
                "workspace": "$workspace",
                "environment": "$test_environment"
            }
        },
        {
            "type": "RunDataPipeline",
            "description": "Running DAX Conversational data enrichments analytics pipelines",
            "ignore": "false",
            "parameters": {
                "workspace": "$workspace",
                "dataPipelineName": "healthcare1_msft_dax_copilot_data_transformation",
                "pipelineParameters": {}
            },
            "outputs": [
                "data_pipeline_id",
                "pipeline_run_id"
            ]
        },
        {
            "type": "PollDataPipeline",
            "description": "Poll data pipeline completion",
            "ignore": "false",
            "parameters": {
                "workspace": "$workspace",
                "item_id": "$data_pipeline_id",
                "job_id": "$pipeline_run_id"
            },
            "outputs": [
                "data_pipeline_activity_details"
            ]
        },
        {
            "type": "RunNotebook",
            "description": "Running DAX deployment tests notebook",
            "parameters": {
                "workspace": "$workspace",
                "environment": "$test_environment",
                "notebook_id": "$dax_conversational_data_enrichments_deployment_test_notebook_id",
                "default_lakehouse": "$bronze_lakehouse"
            },
            "outputs": [
                "dax_conversational_data_enrichments_deployment_test_notebook_run_id"
            ]
        },
        {
            "type": "RunNotebook",
            "description": "Running DAX data validation test notebook",
            "parameters": {
                "workspace": "$workspace",
                "environment": "$test_environment",
                "notebook_id": "$dax_conversational_data_validation_test_notebook_id",
                "default_lakehouse": "$bronze_lakehouse"
            },
            "outputs": [
                "dax_conversational_data_validation_test_notebook_run_id"
            ]
        },
        {
            "type": "PollJobCompletion",
            "description": "Polling deployment validation notebook completion",
            "parameters": {
                "workspace": "$workspace",
                "item_id": "$dax_conversational_data_enrichments_deployment_test_notebook_id",
                "job_id": "$dax_conversational_data_enrichments_deployment_test_notebook_run_id"
            }
        },
        {
            "type": "PollJobCompletion",
            "description": "Polling data validation notebook completion",
            "parameters": {
                "workspace": "$workspace",
                "item_id": "$dax_conversational_data_validation_test_notebook_id",
                "job_id": "$dax_conversational_data_validation_test_notebook_run_id"
            }
        },
        {
            "type": "ParseTestResults",
            "ignore": "false",
            "description": "Polling Dax integration test results",
            "parameters": {
                "workspace": "$workspace",
                "lakehouse": "$test_lakehouse",
                "deployment_environment": "$targetEnvironment",
                "test_name": "DAX Integration"
            }
        }
    ]
}
