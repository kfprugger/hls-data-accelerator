{
    "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
    "handler": "Microsoft.Azure.CreateUIDef",
    "version": "0.1.2-preview",
    "parameters": {
        "config": {
            "isWizard": true,
            "basics": {
                "resourceGroup": {
                    "allowExisting": true
                },
                "location": {
                    "label": "Region",
                    "toolTip": "Location for all azure resources.",
                    "visible": true
                }
             }
        },
        "resourceTypes": [
            "microsoft.resources/resourcegroups"
        ],
        "basics": [
            {
                "name": "cognitiveServiceSelector",
                "type": "Microsoft.Solutions.ResourceSelector",
                "label": "Language service",
                "toolTip": "Specify the language service name.",
                "resourceType": "Microsoft.CognitiveServices/accounts",
				"constraints": {
                    "required": false
                },
                "options": {
                    "filter": {
                        "subscription": "onBasics"
                    }
                }
            },
            {
                "name": "fhirServerUri",
                "type": "Microsoft.Common.TextBox",
                "label": "Fhir Server Uri",
                "defaultValue": "NA",
                "toolTip": "Specify the fhir server uri to export fhir data.",
                "constraints": {
                    "required": false,
                    "regex": "^(https)://.*|NA$",
                    "validationMessage": "Fhir Server Uri must be a valid https url or 'NA'."
                },
                "visible": true
            },
            {
                "name": "exportStartTime",
                "type": "Microsoft.Common.TextBox",
                "label": "Export Start Time",
                "defaultValue": "2023-03-15",
                "toolTip": "Specify the fhir data export start date in yyyy-MM-dd format.",
                "constraints": {
                    "required": false,
                    "regex": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                    "validationMessage": "Export start date must be in yyyy-MM-dd format."
                },
                "visible": true
            },
            {
                "name": "deployUpdatesOnly",
                "type": "Microsoft.Common.CheckBox",
                "label": "Deploy updates only (requires existing deployment)",
                "toolTip": "Check this box only if there is a preexisting deployment that you want updated. Currently only the function app will be updated. All custom configurations, settings, and infrastructure will be preserved. This will fail if resources don't already exist.",
                "constraints": {
                    "required": false
                },
                "visible": true
            },
            {
                "name": "_artifactsLocation",
                "type": "Microsoft.Common.TextBox",
                "label": "_artifacts Location",
                "defaultValue": "[[deployment().properties.templateLink.uri]",
                "toolTip": "Optional. The base URI where artifacts required by this template are located including a trailing '/'",
                "constraints": {
                    "required": false,
                    "regex": "^(https)://.*",
                    "validationMessage": "The artifacts location must be a valid URI beginning with 'https://'. "
                },
                "visible": false
            },
            {
                "name": "_artifactsLocationSasToken",
                "type": "Microsoft.Common.PasswordBox",
                "label": {
                    "password": "_artifacts Location Sas Token",
                    "confirmPassword": "Confirm password"
                },
                "defaultValue": "",
                "toolTip": "The sasToken required to access _artifactsLocation.  When the template is deployed using the accompanying scripts, a sasToken will be automatically generated. Use the defaultValue if the staging location is not secured.",
                "constraints": {
                    "required": false
                },
                "options": {
                    "hideConfirmation": false
                },
                "visible": false
            }
        ],
        "steps": [
            {
                "name": "tags",
                "label": "Tags",
                "elements": [
                    {
                        "name": "tagsByResources",
                        "type": "Microsoft.Common.TagsByResource",
                        "toolTip": "Assign tags to the resources.",
                        "resources": [
                            "Microsoft.Storage/storageAccounts",
                            "Microsoft.Web/serverfarms",
                            "Microsoft.Web/sites",
                            "Microsoft.KeyVault/vaults",
                            "Microsoft.Insights/components",
                            "Microsoft.OperationalInsights/workspaces",
                            "Microsoft.Resources/deploymentScripts"
                        ]
                    }
                ]
            }
        ],
        "outputs": {
            "languageServiceId": "[basics('cognitiveServiceSelector').id]",
            "fhirServerUri": "[basics('fhirServerUri')]",
            "exportStartTime": "[basics('exportStartTime')]",
            "location": "[location()]",
            "_artifactsLocation": "[basics('_artifactsLocation')]",
            "_artifactsLocationSasToken": "[basics('_artifactsLocationSasToken')]",
            "tagsByResources": "[steps('tags').tagsByResources]",
            "deployUpdatesOnly": "[basics('deployUpdatesOnly')]"
        }
    }
}