{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    },
    "logLevel": {
      "default": "Error",
      "Azure.Core": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.IntegratedDataPlatform.ExportProcessor.ExportOrchestrator": "Information",
      "Microsoft.IntegratedDataPlatform.ExportProcessor.Export": "Information",
      "Microsoft.IntegratedDataPlatform.ExportProcessor.Services.Authentication.MSFTAuthenticationService": "Information"
    }
  },
  "extensions": {
    "durableTask": {
      "RollbackEntityOperationsOnExceptions": false
    }
  }
}