        {
            "tableName": "MarketingCampaignTask_assets",
            "enabled": true,
            "query":"SELECT DISTINCT j_com.CommunicationText AS m_assetname, CASE m.MarketingCampaignTaskTypeId WHEN 20000004 THEN 'Email' WHEN 20000005 THEN 'Email' WHEN 20000008 THEN 'Email' WHEN 20000009 THEN 'Email' WHEN 20000010 THEN 'Sms' WHEN 20000011 THEN 'Sms' WHEN 20000012 THEN 'Sms' WHEN 20000006 THEN 'Sms' WHEN 20000013 THEN 'PushNotification' WHEN 20000014 THEN 'PushNotification' WHEN 20000015 THEN 'PushNotification' WHEN 20000016 THEN 'PushNotification' END AS m_channelname, j_com.SourceModifiedOn as m_modified_date FROM MarketingCampaignTask m LEFT JOIN MarketingCampaignTaskCommunication j_rel_e_communication ON j_rel_e_communication.TaskId = m.TaskId LEFT JOIN IdmCommunication j_com ON j_com.CommunicationId = j_rel_e_communication.CommunicationId WHERE m.MarketingCampaignTaskTypeId IN ( 20000004, 20000005, 20000008, 20000009, 20000010, 20000011, 20000012, 20000006, 20000013, 20000014, 20000015, 20000016 )",
            "modifiedonField": "m_modified_date",
            "targetAnchorTables": [
                {
                    "tableName": "MarketingAssetDim"
                }
            ],
            "sourceFields": [
                {
                    "fieldName": "m_assetid",
                    "fieldCalculatedValue": "concat_ws('<->', m_channelname, m_assetname)",
                    "enabled": true,
                    "fieldType": "string",
                    "targetFields": {
                        "fields": [
                            {
                                "tableName": "MarketingAssetDim",
                                "fieldName": "AssetKey"
                            }
                        ]
                    }
                },
                {
                    "fieldName": "m_assetname",
                    "fieldType": "string",
                    "targetFields": {
                        "fields": [
                            {
                                "tableName": "MarketingAssetDim",
                                "fieldName": "AssetName"
                            }
                        ]
                    }
                },
                {
                    "fieldName": "m_channelname",
                    "enabled": true,
                    "fieldType": "string",
                    "targetFields": {
                        "fields": [
                            {
                                "tableName": "MarketingAssetDim",
                                "fieldName": "AssetType"
                            }
                        ]
                    }
                }
            ]
