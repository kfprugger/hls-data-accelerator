        {
            "tableName": "MarketingCampaignTask_eventfact",
            "enabled": true,
            "query": "SELECT m.TaskId AS m_id ,m.CreatedOn AS m_modifiedon ,m.CreatedOn AS m_eventdate, DATE_FORMAT(m.CreatedOn, 'MMM-yyyy') AS m_month_year, j_base.RelatedTaskId AS m_journeyid, m.MarketingCampaignTaskTypeId as m_tasktypeid, CASE m.MarketingCampaignTaskTypeId WHEN 20000004 THEN 'Email' WHEN 20000005 THEN 'Email' WHEN 20000008 THEN 'Email' WHEN 20000009 THEN 'Email' WHEN 20000010 THEN 'Sms' WHEN 20000011 THEN 'Sms' WHEN 20000012 THEN 'Sms' WHEN 20000006 THEN 'Sms' WHEN 20000013 THEN 'PushNotification' WHEN 20000014 THEN 'PushNotification' WHEN 20000015 THEN 'PushNotification' WHEN 20000016 THEN 'PushNotification' END AS m_channelname ,CASE m.MarketingCampaignTaskTypeId WHEN 20000004 THEN 'Sent' WHEN 20000005 THEN 'Opened' WHEN 20000008 THEN 'Clicked' WHEN 20000009 THEN 'Delivered' WHEN 20000010 THEN 'Delivered' WHEN 20000011 THEN 'Clicked' WHEN 20000012 THEN 'NotSent' WHEN 20000006 THEN 'Sent' WHEN 20000013 THEN 'Opened' WHEN 20000014 THEN 'Clicked' WHEN 20000015 THEN 'Sent' WHEN 20000016 THEN 'NotSent' END AS m_channelaction ,patinet_rel.PartyId AS m_patientpartyid ,patinet_rel.CorrelationId AS m_patientfhirid ,NULL AS m_appointmentid ,j_com.CommunicationText AS m_assetname FROM MarketingCampaignTask m LEFT JOIN RelatedMarketingCampaignTask j_rel ON j_rel.TaskId = m.TaskId AND j_rel.TaskRelationshipTypeId IN ( 20000016 ,20000013 ,20000008 ,20000010 ,20000019 ,20000022 ,20000028 ,20000025 ,20000031 ,20000034 ,20000037 ,20000040 ) LEFT JOIN RelatedMarketingCampaignTask j_base ON j_base.TaskId = j_rel.RelatedTaskId LEFT JOIN MarketingCampaignTaskRelatedParty pat_rel ON pat_rel.TaskId = m.TaskId AND pat_rel.TaskPartyRelationshipTypeId IN ( 20000005 ,20000007 ,20000009 ,20000011 ,20000013 ,20000015 ,20000019 ,20000017 ,20000021 ,20000023 ,20000025 ,20000027 ) LEFT JOIN IdmPatient patinet_rel ON patinet_rel.PartyId = pat_rel.PartyId LEFT JOIN MarketingCampaignTaskCommunication j_rel_e_communication ON j_rel_e_communication.TaskId = m.TaskId LEFT JOIN IdmCommunication j_com ON j_com.CommunicationId = j_rel_e_communication.CommunicationId WHERE m.MarketingCampaignTaskTypeId IN ( 20000004 ,20000005 ,20000008 ,20000009 ,20000010 ,20000011 ,20000012 ,20000006 ,20000013 ,20000014 ,20000015 ,20000016 )",
            "modifiedonField": "m_modifiedon",
