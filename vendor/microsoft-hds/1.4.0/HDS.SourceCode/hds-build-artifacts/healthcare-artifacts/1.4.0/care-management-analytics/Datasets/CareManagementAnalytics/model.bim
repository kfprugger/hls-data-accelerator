        "partitions": [
          {
            "name": "measurement",
            "mode": "directQuery",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(\"%%sql_endpoint%%\", \"%%default_lakehouse_name%%\"),",
                "    dbo_measurement = Source{[Schema=\"dbo\",Item=\"measurement\"]}[Data]",
                "in",
                "    dbo_measurement"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "count_high_Hemoglobin_A1c",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT(Measurement[person_id]),",
              "    Measurement[measurement_text_source_value] = \"Hemoglobin A1c/Hemoglobin.total in Blood\",",
              "    Measurement[value_as_number] >= 0.8",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "99dbb97b-9a37-405a-96e5-20c7ad485b89"
          },
          {
            "name": "count_low_Hemoglobin_A1c",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT(Measurement[person_id]),",
              "    Measurement[measurement_text_source_value] = \"Hemoglobin A1c/Hemoglobin.total in Blood\",",
              "    Measurement[value_as_number] < 0.8",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "3255d5ba-d60a-401e-b5aa-44a82ac6a561"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
