        "partitions": [
          {
            "name": "person",
            "mode": "directQuery",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(\"%%sql_endpoint%%\", \"%%default_lakehouse_name%%\"),",
                "    dbo_person = Source{[Schema=\"dbo\",Item=\"person\"]}[Data]",
                "in",
                "    dbo_person"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "count_gender_female",
            "expression": "COALESCE(CALCULATE(COUNTROWS('person'), 'person'[gender_source_value] = \"female\"),0)",
            "formatString": "0",
            "lineageTag": "67865166-0308-4b9d-8001-cce5907d5ed0"
          },
          {
            "name": "count_gender_male",
            "expression": "COALESCE(CALCULATE(COUNTROWS('person'), 'person'[gender_source_value] = \"male\"),0)",
            "formatString": "0",
            "lineageTag": "eeb17f6b-cf38-4b89-881b-fe6d3cc6cced"
          },
          {
            "name": "count_gender_unkown",
            "expression": "COALESCE(CALCULATE(COUNTROWS('person'), 'person'[gender_source_value] = \"unknown\"),0)",
            "formatString": "0",
            "lineageTag": "78f6baf1-c018-405d-9dca-5624e0a3f883"
          },
          {
            "name": "PatientsByAgeGroup",
            "expression": [
              "CALCULATE(",
              "    COUNT('person'[person_id]),",
              "    ALLEXCEPT('person', 'person'[AgeGroup])",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "ac322231-b1e9-428f-bbef-eac42c6cc010"
          }
        ],
