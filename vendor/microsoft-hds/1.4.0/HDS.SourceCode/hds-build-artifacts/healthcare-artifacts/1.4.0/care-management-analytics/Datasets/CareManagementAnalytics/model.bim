        "partitions": [
          {
            "name": "cost",
            "mode": "directQuery",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(\"%%sql_endpoint%%\", \"%%default_lakehouse_name%%\"),",
                "    dbo_cost = Source{[Schema=\"dbo\",Item=\"cost\"]}[Data]",
                "in",
                "    dbo_cost"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "cost_gender_female",
            "expression": "COALESCE(CALCULATE(SUM(cost[total_charge]), 'person'[gender_source_value] = \"female\"),0)",
            "lineageTag": "fb5ca3b2-ebbb-4ffa-a986-436c64952905",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "cost_gender_male",
            "expression": "COALESCE(CALCULATE(SUM(cost[total_charge]), 'person'[gender_source_value] = \"male\"),0)",
            "lineageTag": "bc04aa66-e948-4268-a991-323aa6b71dac",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "cost_gender_unknown",
            "expression": "COALESCE(CALCULATE(SUM(cost[total_charge]), 'person'[gender_source_value] = \"unknown\"),0)",
            "lineageTag": "29f34903-44fd-4a73-a692-7128c326ee09",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "TotalCostByCondition",
            "expression": [
              "CALCULATE(",
              "    SUM('cost'[total_charge])",
              ")"
            ],
            "lineageTag": "6d7b84a1-0491-41bb-a485-93f26b86b4d5",
            "annotations": [
              {
