{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "stars_by_measure",
  "position": {
    "x": 15,
    "y": 140,
    "z": 2000,
    "height": 250,
    "width": 400,
    "tabOrder": 2000
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "star_rating_detail"
                    }
                  },
                  "Property": "measure_name"
                }
              },
              "queryRef": "star_rating_detail.measure_name",
              "nativeQueryRef": "measure_name",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Measure Star Rating"
                }
              },
              "queryRef": "_Measures.Measure Star Rating",
              "nativeQueryRef": "Measure Star Rating"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}
